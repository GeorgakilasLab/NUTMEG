{
  "model": {
    "mode": "multiome",
    "hidden_dim": 24,
    "heads": 4,
    "dropout": 0.3,
    "per_gene_hidden": 12,
    "include_presence_bit": true,
    "return_intermediates": true
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.0005,
    "weight_decay": 0.001,
    "loss_name": "ce",
    "label_smooth_train": 0.05,

    "max_epochs": 30,
    "patience": 5,
    "min_delta": 0.001,

    "train_batch_size": 64,
    "grad_clip_norm": 2.0,

    "es_val_frac": 0.05,
    "seed": 12345
  }
}
